generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma"
  binaryTargets = ["native", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model admin {
  id       Int        @id @default(autoincrement())
  name     String
  email    String     @unique
  password String
  createAt DateTime   @default(now())
  updateAt DateTime   @updatedAt
  role     admin_role @default(admin)
}

model alumni {
  id          Int      @id @default(autoincrement())
  name        String
  angkatan    String
  img_alumni  String
  description String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model news {
  id        Int           @id @default(autoincrement())
  category  news_category @default(berita)
  title     String
  content   String        @db.MediumText
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  thumbnail String

  link_berita link_berita[]
}

model link_berita {
  id        Int      @id @default(autoincrement())
  label     String
  link      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  newsId Int
  news   news @relation(fields: [newsId], references: [id], onDelete: Cascade)
}

model pamflet {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  pamflet   String
}

model student {
  id                  Int                   @id @default(autoincrement())
  jenis_sekolah       student_jenis_sekolah
  nisn                String
  nik                 String
  nama_lengkap        String
  jenis_kelamin       student_jenis_kelamin
  usia                Int
  tempat_lahir        String
  tanggal_lahir       DateTime
  alamat              String
  anak_ke             Int
  jumlah_saudara      Int
  asal_sekolah        String
  alamat_sekolah_asal String
  nama_lengkap_ayah   String
  nama_lengkap_ibu    String
  nama_lengkap_wali   String?               @default("-")
  foto_formal         String
  fc_akta_kelahiran   String
  foto_kk             String
  fc_ktp              String
  fc_kis_kip          String
  no_telepon          String
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([createdAt])
  @@index([jenis_kelamin])
  @@index([jenis_sekolah])
}

model ustad {
  id            Int                 @id @default(autoincrement())
  name          String
  jenis_kelamin ustad_jenis_kelamin
  tanggal_lahir String
  alamat        String
  no_telepon    String
  jabatan       String
  ustad_img     String
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  tempat_lahir  String
}

model fasilitas {
  id         Int      @id @default(autoincrement())
  fasilitas  String
  keterangan String
  images     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model banner {
  id        Int      @id @default(autoincrement())
  banner    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model jumlah_alumni {
  id        Int      @id @default(autoincrement())
  laki_laki Int
  perempuan Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model pendaftaran {
  id        Int      @id @default(autoincrement())
  dari      DateTime
  sampai    DateTime
  aktif     Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model prestasi {
  id                Int               @id @default(autoincrement())
  category_prestasi category_prestasi
  nama              String
  tahun_prestasi    Int
  prestasi          String
  photo             String
  jenis_kelamin     jenis_kelamin

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category_prestasi])
  @@index([category_prestasi, tahun_prestasi])
}

enum news_category {
  berita
  artikel
}

enum student_jenis_sekolah {
  SD
  SMP
  SMA
}

enum ustad_jenis_kelamin {
  laki_laki
  perempuan
}

enum student_jenis_kelamin {
  laki_laki
  perempuan
}

enum admin_role {
  admin
}

enum category_prestasi {
  internasional
  nasional
  provinsi
  kabupaten
  kecamatan
}

enum jenis_kelamin {
  laki_laki
  perempuan
}
